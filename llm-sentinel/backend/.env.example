# ==============================================================================
# LLM Sentinel - Environment Configuration Example
# Copy this file to .env and configure your secrets:
#   cp .env.example .env
# ==============================================================================

# General Application Settings
APP_NAME="LLM Sentinel"
APP_ENV=development
DEBUG=false

# LLM Provider Selection (gemini, claude)
LLM_PROVIDER=gemini

# Google Gemini Settings (get your key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Operational Settings
REQUEST_TIMEOUT_SECONDS=60.0

